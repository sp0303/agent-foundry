# Copy to bridge/.env and fill in. .env is gitignored — never commit real keys.

# Worker API keys (workers run on API keys, not personal subscriptions).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# GitHub webhook HMAC secret (same value you set on the repo webhook).
GITHUB_WEBHOOK_SECRET=

# Where workers operate. Defaults to the current directory.
BRIDGE_REPO_DIR=.
BRIDGE_DB=bridge.sqlite
BRIDGE_MAX_REVIEW_ROUNDS=3
